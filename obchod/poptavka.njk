<section class="poptavka">
  <div class="poptavka__container container">
    <h1 class="poptavka__heading">Poptávka plakátu</h1>
    <p class="poptavka__text">Napište mi, o které plakáty máte zájem, a ozvu se vám s dalšími informacemi (platba, doručení).</p>

    <form action="https://api.web3forms.com/submit" method="POST" novalidate class="poptavka__form">
      <input type="hidden" name="access_key" value="224e6b87-7393-4341-aec3-7caa72ba8c52">
      <input type="hidden" name="_email.subject" value="Nová poptávka plakátu">
      <input type="checkbox" name="botcheck" style="display: none;">

      <label for="jmeno">Jméno a příjmení *</label>
      <input type="text" id="jmeno" name="name" required>

      <label for="email">E-mail *</label>
      <input type="email" id="email" name="email" required>

      <label for="polozky">Vaše poptávka *</label>
      <textarea id="polozky" name="message" rows="4" required></textarea>

      <button type="submit" class="poptavka__button-cta">Odeslat poptávku</button>
      <div id="form-status" class="poptavka__status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

