layout: layout.njk
title: Poptávka | Martina Kurková Nožičková
permalink: "/obchod/poptavka/"
---

<section class="inquiry">
  <div class="inquiry__container container">
    <h1 class="inquiry__heading">Poptávka plakátu</h1>
    <p class="inquiry__text">Napište mi, o které plakáty máte zájem, a ozvu se vám s dalšími informacemi (platba, doručení).</p>

    <form action="https://api.web3forms.com/submit" method="POST" novalidate class="inquiry__form">
      <input type="hidden" name="access_key" value="2b8a480d-e053-488b-b74f-8bcf6d0df13f">
      <input type="hidden" name="_email.subject" value="Nová poptávka plakátu">
      <input type="checkbox" name="botcheck" class="inquiry__botcheck" tabindex="-1" autocomplete="off">

      <fieldset class="inquiry__fieldset">
        <legend class="inquiry__legend">Vaše údaje</legend>

        <label for="jmeno" class="inquiry__label">Jméno a příjmení *</label>
        <input
          type="text"
          id="jmeno"
          name="name"
          class="inquiry__input"
          placeholder="Jana Nováková"
          required
          aria-describedby="jmeno-error"
        >
        <span id="jmeno-error" class="inquiry__error"></span>

        <label for="email" class="inquiry__label">E-mail *</label>
        <input
          type="email"
          id="email"
          name="email"
          class="inquiry__input"
          placeholder="jana.novakova@email.cz"
          required
          aria-describedby="email-error"
        >
        <span id="email-error" class="inquiry__error"></span>

                <label for="telefon" class="inquiry__label">Telefon</label>
        <input
          type="tel"
          id="telefon"
          name="telefon"
          class="inquiry__input"
          placeholder="+420 601 234 567"
          aria-describedby="telefon-error"
        >
        <span id="telefon-error" class="inquiry__error"></span>

        <label for="ulice" class="inquiry__label">Ulice a č.p. *</label>
        <input
          type="text"
          id="ulice"
          name="ulice"
          class="inquiry__input"
          placeholder="Květinová 123"
          required
          aria-describedby="ulice-error"
        >
        <span id="ulice-error" class="inquiry__error"></span>

        <label for="mesto" class="inquiry__label">Město *</label>
        <input
          type="text"
          id="mesto"
          name="mesto"
          class="inquiry__input"
          placeholder="Sadská"
          required
          aria-describedby="mesto-error"
        >
        <span id="mesto-error" class="inquiry__error"></span>

        <label for="psc" class="inquiry__label">PSČ *</label>
        <input
          type="text"
          id="psc"
          name="psc"
          class="inquiry__input"
          placeholder="289 12"
          inputmode="numeric"
          required
          aria-describedby="psc-error"
        >
        <span id="psc-error" class="inquiry__error"></span>

        <label for="polozky" class="inquiry__label inquiry__label--textarea">Vaše poptávka *</label>
        <textarea
          id="polozky"
          name="message"
          rows="4"
          class="inquiry__textarea"
          placeholder="Mám zájem o tisk „Keporkak“, 30 × 40 cm."
          required
          aria-describedby="polozky-error"
        ></textarea>
        <span id="polozky-error" class="inquiry__error"></span>
      </fieldset>

      <fieldset class="inquiry__fieldset inquiry__fieldset--radio" aria-describedby="doruceni-error">
        <legend class="inquiry__legend">Způsob doručení *</legend>

        <div class="inquiry__radio-group">
          <label class="inquiry__radio-label">
            <input type="radio" name="doruceni" value="Zásilkovna – výdejní místo" class="inquiry__radio" required>
            Zásilkovna – výdejní místo
          </label>

          <label class="inquiry__radio-label">
            <input type="radio" name="doruceni" value="Zásilkovna – doručení domů" class="inquiry__radio">
            Zásilkovna – doručení domů
          </label>

          <label class="inquiry__radio-label">
            <input type="radio" name="doruceni" value="Balíkovna – výdejní místo" class="inquiry__radio">
            Balíkovna – výdejní místo
          </label>

          <label class="inquiry__radio-label">
            <input type="radio" name="doruceni" value="Balíkovna – doručení domů" class="inquiry__radio">
            Balíkovna – doručení domů
          </label>

          <label class="inquiry__radio-label">
            <input type="radio" name="doruceni" value="Osobní odběr v Sadské" class="inquiry__radio">
            Osobní odběr v Sadské
          </label>
        </div>

        <span id="doruceni-error" class="inquiry__error"></span>
      </fieldset>

      <button type="submit" class="inquiry__button">Odeslat poptávku</button>
      <div id="form-status" class="inquiry__status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<script src="/js/poptavka.js"></script>