---
pagination:
  data: plakaty
  size: 1
  alias: plakat
permalink: "/obchod/{{ plakat.slug }}/"
layout: layout.njk

# Dynamické SEO & Meta tagy
eleventyComputed:
  title: "Plakát {{ plakat.nazev }} | Autorský tisk | Martina Kurková Nožičková"
  description: "Autorský ilustrovaný plakát {{ plakat.nazev }}. {{ plakat.popis }} Kvalitní tisk na papír {{ plakat.papir }}."

  # Social & Open Graph
  metaTitle: "Plakát {{ plakat.nazev }} | Martina Kurková Nožičková"
  ogDescription: "Autorský tisk {{ plakat.nazev }}. {{ plakat.popis }}"
  ogImage: "/images/obchod/{{ plakat.slozka_obrazku }}/{{ plakat.obrazky[0].soubor }}_800.webp"
  ogType: "product"
  twitterCard: "summary_large_image"
---

<section class="product">
  <div class="product__container">

  <div class="product__image-container">
    {% set hlavni = plakat.obrazky[0] %}
    {% set hlavni_format = hlavni.format or "webp" %}
    <div class="product__image-main" onclick="openLightbox(0)">
      <img src="/images/obchod/{{ plakat.slozka_obrazku }}/{{ hlavni.soubor }}{% if hlavni_format == 'svg' %}.svg{% else %}_800.webp{% endif %}"
          {% if hlavni_format != 'svg' %}
          srcset="/images/obchod/{{ plakat.slozka_obrazku }}/{{ hlavni.soubor }}_350.webp 350w,
                /images/obchod/{{ plakat.slozka_obrazku }}/{{ hlavni.soubor }}_420.webp 420w,
                /images/obchod/{{ plakat.slozka_obrazku }}/{{ hlavni.soubor }}_650.webp 650w,
                /images/obchod/{{ plakat.slozka_obrazku }}/{{ hlavni.soubor }}_800.webp 800w"
          sizes="(max-width: 768px) 100vw, 66vw"
          {% endif %}
          data-full="/images/obchod/{{ plakat.slozka_obrazku }}/{{ hlavni.soubor }}_800.webp"
        alt="Plakát {{ plakat.nazev }}"
        class="product__image"
        id="mainImg"
        loading="eager"
        fetchpriority="high"
        width="800" height="800">
    </div>

    <div class="product__thumbnails">
      {% for obr in plakat.obrazky %}
      {% set format = obr.format or "webp" %}
      <div class="product__thumbnail{% if loop.first %} active{% endif %}" onclick="changeImage({{ loop.index0 }})">
        <img src="/images/obchod/{{ plakat.slozka_obrazku }}/{{ obr.soubor }}{% if format == 'svg' %}.svg{% else %}_350.webp{% endif %}"
          data-full="/images/obchod/{{ plakat.slozka_obrazku }}/{{ obr.soubor }}_800.webp"
          alt="Kresba {{ plakat.nazev }} - ukázka {{ loop.index }}"
          class="product_thumbnail-image"
          loading="lazy" width="350" height="350">
      </div>
      {% endfor %}
    </div>
  </div>

    <div class="product__text-container">
  <h1 class="product__heading">{{ plakat.nazev }}</h1>
  <p class="product__text">{{ plakat.popis }}</p>
  <p class="product__text">Rám není součástí balení.</p>

  <ul class="product__list">
    <li class="product__list-item"><span class="product__label">Papír: </span>{{ plakat.papir }}</li>
    <li class="product__list-item"><span class="product__label">Tisk: </span>{{ plakat.tisk }}</li>
    <li class="product__list-item product__list-item--variants">
      <span class="product__label">Formát:</span>
      <div class="product__variants">
        {% for f in plakat.formaty %}
        <label class="product__variant">
          <input type="radio" name="format" class="product__accent-radio" value="{{ f.velikost }}" data-price="{{ f.cena }}" {% if loop.first %}checked{% endif %}>
          {% if f.typ %}{{ f.typ }}, {% endif %}{{ f.velikost }}
        </label>
        {% endfor %}
      </div>
    </li>
</ul>

<div class="product__price" id="productPrice"></div>

  <div class="product__buy">
    <div class="product__buttons">
      <a href="#" class="product__button-cta" id="ctaButton" data-nazev="{{ plakat.nazev }}">Mám zájem</a>
      <a href="/obchod/" class="product__back--link">← Zpět do obchodu</a>
    </div>
  </div>
</div>

  </div>
</section>

<script src="/js/product.js"></script>